#!/bin/sh
set -eu
cd /app
python docker/setup.py
node --preserve-symlinks --preserve-symlinks-main /app/.runtime/bench/apps/frappe/socketio.js > /app/.runtime/bench/logs/socket.log 2>&1 &
socket_pid=$!
cd /app/.runtime/bench/sites
python -m frappe.utils.bench_helper frappe worker > ../logs/worker.log 2>&1 &
worker_pid=$!
scheduler_pid=""
if [ "$(cat ../.outside-configured)" = yes ]; then
  python -m frappe.utils.bench_helper frappe schedule > ../logs/scheduler.log 2>&1 &
  scheduler_pid=$!
fi
cleanup() { kill "$socket_pid" "$worker_pid" ${scheduler_pid:+"$scheduler_pid"} 2>/dev/null || true; }
trap cleanup EXIT INT TERM
if [ "${HELPDESK_DEVELOPMENT:-0}" = 1 ]; then
  python -m frappe.utils.bench_helper frappe --site "$HELPDESK_SITE_NAME" serve --port 8000 --noreload
else
  gunicorn --bind 0.0.0.0:8000 --workers 2 --threads 4 --timeout 120 --chdir /app/.runtime/bench/sites --pythonpath /app/docker 'web:application'
fi
